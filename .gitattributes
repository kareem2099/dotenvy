# Normalize line endings: LF in the repository, consistent checkouts on all OSes.
* text=auto eol=lf

# Windows launcher scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.vsix binary
*.woff binary
*.woff2 binary
