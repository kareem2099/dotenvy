# Package allowlist: exclude everything, then include only what the extension
# needs at runtime. The extension and Git hook are esbuild bundles (dist/), so
# out/, src/ and node_modules/ are not shipped. Run `vsce ls` to check.
**

!package.json
!package.nls*.json
!README.md
!CHANGELOG.md
!LICENSE

# Bundled extension and Git hook CLI (no source maps)
!dist/extension.js
!dist/git-hook.js

# Webview pages, scripts and bundled stylesheets (styles/ is bundled into panel.css)
!resources/panel/*.html
!resources/panel/*.js
!resources/panel/panel.css
!resources/panel/analytics.css
!resources/panel/secrets-scanner.css

# Icons referenced by package.json and the panels
!resources/icons/icon.png
!resources/icons/activity-bar.svg
!resources/icons/dotenvyignoreIcon.svg

# Final safety exclusions, after resource inclusion rules.
# Local settings/envelopes and credential material are never package resources.
**/.env
**/.env.*
**/*.env
**/.envrc
**/.dotenvy.json
**/.dotenvy.lock.json
**/.dotenvyGit.json
**/.dotenvy/**
**/.dotenvy-backups/**
**/.railway/**
**/.railway-credentials*.json
**/.aws/**
**/.ssh/**
**/.npmrc
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.keystore
**/id_rsa
**/id_ed25519
**/*service-account*.json
**/*service_account*.json
**/*serviceaccount*.json
**/*credentials*.json
**/credentials.json
**/backups/**
**/*.enc
**/*.vsix
**/*.tgz
**/*.zip
**/*.bak
**/*.backup
.gitguardian.yaml
.gitattributes
.vscode/**
