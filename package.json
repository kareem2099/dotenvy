{
  "name": "dotenvy",
  "displayName": "%displayName%",
  "description": "%description%",
  "localizations": [
    {
      "languageId": "it",
      "translations": [
        {
          "id": "package",
          "path": "./package.nls.it.json"
        }
      ]
    },
    {
      "languageId": "ar",
      "translations": [
        {
          "id": "package",
          "path": "./package.nls.ar.json"
        }
      ]
    },
    {
      "languageId": "ru",
      "translations": [
        {
          "id": "package",
          "path": "./package.nls.ru.json"
        }
      ]
    }
  ],
  "version": "2.2.4",
  "icon": "resources/icons/icon.png",
  "publisher": "FreeRave",
  "author": "Kareem Ehab",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "Productivity",
    "env",
    "environment",
    "dotenv",
    "security",
    "encryption",
    "sync",
    "secrets"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/.env",
    "workspaceContains:**/.env.*"
  ],
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/kareem2099/dotenvy"
  },
  "bin": {
    "dotenvy-hook": "./out/git-hook.js"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src/**/*.ts",
    "test": "node test/run-all-tests.js"
  },
  "contributes": {
    "languages": [
      {
        "id": "dotenvyignore",
        "filenames": [
          ".dotenvyignore"
        ],
        "icon": {
          "light": "./resources/icons/dotenvyignoreIcon.svg",
          "dark": "./resources/icons/dotenvyignoreIcon.svg"
        }
      }
    ],
    "configuration": {
      "title": "DotEnvy",
      "properties": {
        "dotenvy.backupPath": {
          "type": "string",
          "default": "",
          "description": "%config.backupPath%"
        },
        "dotenvy.encryptBackups": {
          "type": "boolean",
          "default": true,
          "description": "%config.encryptBackups%"
        },
        "dotenvy.history.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.history.enabled%"
        },
        "dotenvy.history.retentionDays": {
          "type": "number",
          "default": 180,
          "minimum": 1,
          "maximum": 3650,
          "description": "%config.history.retentionDays%"
        },
        "dotenvy.history.maxEntries": {
          "type": "number",
          "default": 1000,
          "minimum": 10,
          "maximum": 10000,
          "description": "%config.history.maxEntries%"
        },
        "dotenvy.history.autoCleanup": {
          "type": "boolean",
          "default": true,
          "description": "%config.history.autoCleanup%"
        },
        "dotenvy.cloudSync.encryptCloudSync": {
          "type": "boolean",
          "default": true,
          "description": "%config.cloudSync.encryptCloudSync%"
        },
        "dotenvy.cloudSync.provider": {
          "type": "string",
          "default": "doppler",
          "enum": [
            "doppler",
            "vercel",
            "aws"
          ],
          "description": "%config.cloudSync.provider%"
        },
        "dotenvy.secrets.enableCloudAnalysis": {
          "type": "boolean",
          "default": false,
          "description": "%config.secrets.enableCloudAnalysis%",
          "deprecationMessage": "%config.secrets.cloudAnalysisDeprecated%"
        },
        "dotenvy.secrets.enableCommunityLearning": {
          "type": "boolean",
          "default": false,
          "description": "%config.secrets.enableCommunityLearning%",
          "scope": "application"
        },
        "dotenvy.secrets.enableModelUpdates": {
          "type": "boolean",
          "default": true,
          "description": "%config.secrets.enableModelUpdates%",
          "scope": "application"
        }
      }
    },
    "commands": [
      {
        "command": "dotenvy.scanSecrets",
        "title": "%command.scanSecrets%",
        "icon": "$(search-view-icon)"
      },
      {
        "command": "dotenvy.switchEnvironment",
        "title": "%command.switchEnvironment%"
      },
      {
        "command": "dotenvy.initDotenvyIgnore",
        "title": "%command.initDotenvyIgnore%",
        "icon": "$(exclude)"
      },
      {
        "command": "dotenvy.addToIgnore",
        "title": "%command.addToIgnore%",
        "icon": "$(eye-closed)"
      },
      {
        "command": "dotenvy.openEnvironmentPanel",
        "title": "%command.openEnvironmentPanel%"
      },
      {
        "command": "dotenvy.openVariableManager",
        "title": "%command.openVariableManager%",
        "icon": "$(edit)"
      },
      {
        "command": "dotenvy.validateEnvironment",
        "title": "%command.validateEnvironment%"
      },
      {
        "command": "dotenvy.diffEnvironment",
        "title": "%command.diffEnvironment%"
      },
      {
        "command": "dotenvy.compareEnvironments",
        "title": "%command.compareEnvironments%"
      },
      {
        "command": "dotenvy.installGitHook",
        "title": "%command.installGitHook%"
      },
      {
        "command": "dotenvy.removeGitHook",
        "title": "%command.removeGitHook%"
      },
      {
        "command": "dotenvy.pullFromCloud",
        "title": "%command.pullFromCloud%"
      },
      {
        "command": "dotenvy.diffCloud",
        "title": "%command.diffCloud%"
      },
      {
        "command": "dotenvy.pushToCloud",
        "title": "%command.pushToCloud%"
      },
      {
        "command": "dotenvy.feedback",
        "title": "%command.feedback%"
      },
      {
        "command": "dotenvy.viewEnvironmentHistory",
        "title": "%command.viewEnvironmentHistory%"
      },
      {
        "command": "dotenvy.openHistoryPanel",
        "title": "%command.openHistoryPanel%",
        "icon": "$(history)"
      },
      {
        "command": "dotenvy.openAnalyticsPanel",
        "title": "%command.openAnalyticsPanel%",
        "icon": "$(graph)"
      },
      {
        "command": "dotenvy.openTimelinePanel",
        "title": "%command.openTimelinePanel%",
        "icon": "$(history)"
      },
      {
        "command": "dotenvy.initSecureProject",
        "title": "%command.initSecureProject%",
        "icon": "$(shield-lock)"
      },
      {
        "command": "dotenvy.addUser",
        "title": "%command.addUser%",
        "icon": "$(person-add)"
      },
      {
        "command": "dotenvy.revokeUser",
        "title": "%command.revokeUser%",
        "icon": "$(person-remove)"
      },
      {
        "command": "dotenvy.loginToSecureProject",
        "title": "%command.loginToSecureProject%",
        "icon": "$(unlock)"
      },
      {
        "command": "dotenvy.showChangelog",
        "title": "%command.showChangelog%",
        "category": "DotEnvy"
      },
      {
        "command": "dotenvy.backup",
        "title": "%command.backup%",
        "icon": "$(archive)"
      },
      {
        "command": "dotenvy.restore",
        "title": "%command.restore%",
        "icon": "$(history)"
      },
      {
        "command": "dotenvy.openTrashBin",
        "title": "%command.openTrashBin%",
        "icon": "$(trash)"
      },
      {
        "command": "dotenvy.resetSecretCorrections",
        "title": "%command.resetSecretCorrections%",
        "icon": "$(clear-all)"
      },
      {
        "command": "dotenvy.toggleCommunityLearning",
        "title": "%command.toggleCommunityLearning%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dotenvy",
          "title": "%views.container.title%",
          "icon": "./resources/icons/icon.png"
        }
      ]
    },
    "views": {
      "dotenvy": [
        {
          "id": "dotenvy.environments",
          "name": "%views.environments.name%",
          "type": "webview",
          "icon": "$(settings-gear)"
        },
        {
          "id": "dotenvy.commands",
          "name": "%views.commands.name%",
          "type": "tree",
          "icon": "$(lock)"
        }
      ]
    },
    "menus": {
      "commandPalette": [],
      "view/title": [
        {
          "command": "dotenvy.openVariableManager",
          "when": "view == dotenvy.environments",
          "group": "navigation@0"
        },
        {
          "command": "dotenvy.openHistoryPanel",
          "when": "view == dotenvy.environments",
          "group": "navigation@1"
        },
        {
          "command": "dotenvy.openAnalyticsPanel",
          "when": "view == dotenvy.environments",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "dotenvy.addToIgnore",
          "group": "navigation@2"
        }
      ]
    }
  },
  "homepage": "https://github.com/kareem2099/dotenvy",
  "bugs": {
    "url": "https://github.com/kareem2099/dotenvy/issues"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/vscode": "1.90.0",
    "dotenv": "^18.0.6",
    "eslint": "^10.12.0",
    "glob": "^13.0.6",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "uuid": "^14.0.2"
  }
}
